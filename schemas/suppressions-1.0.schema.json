{
  "$id": "https://github.com/borborich/pgextassure/raw/main/schemas/suppressions-1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "severity": {"enum": ["critical", "high", "medium", "low"]}
  },
  "additionalProperties": false,
  "properties": {
    "ruleset_version": {"maxLength": 128, "minLength": 1, "type": "string"},
    "schema_version": {"const": "1.0"},
    "suppressions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expires_on": {"format": "date", "type": "string"},
          "owner": {"maxLength": 256, "minLength": 1, "type": "string"},
          "reason": {"maxLength": 4096, "minLength": 1, "type": "string"},
          "root_cause_id": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "rule_id": {
            "pattern": "^[a-z][a-z0-9.-]{0,127}$",
            "type": "string"
          },
          "severity": {"$ref": "#/$defs/severity"},
          "ticket": {"maxLength": 512, "minLength": 1, "type": "string"}
        },
        "required": [
          "root_cause_id",
          "rule_id",
          "severity",
          "owner",
          "reason",
          "expires_on"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": ["schema_version", "ruleset_version", "suppressions"],
  "title": "PgExtAssure suppressions 1.0",
  "type": "object"
}
