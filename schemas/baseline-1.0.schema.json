{
  "$id": "https://github.com/borborich/pgextassure/raw/main/schemas/baseline-1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "severity": {"enum": ["critical", "high", "medium", "low"]}
  },
  "additionalProperties": false,
  "properties": {
    "created_on": {"format": "date", "type": "string"},
    "root_causes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "root_cause_id": {"$ref": "#/$defs/digest"},
          "rule_id": {
            "pattern": "^[a-z][a-z0-9.-]{0,127}$",
            "type": "string"
          },
          "severity": {"$ref": "#/$defs/severity"}
        },
        "required": ["root_cause_id", "rule_id", "severity"],
        "type": "object"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "schema_version": {"const": "1.0"},
    "source": {
      "additionalProperties": false,
      "properties": {
        "generation_plan_digest": {"$ref": "#/$defs/digest"},
        "manifest_digest": {"$ref": "#/$defs/digest"}
      },
      "required": ["manifest_digest"],
      "type": "object"
    },
    "tool": {
      "additionalProperties": false,
      "properties": {
        "name": {"const": "pgextassure"},
        "ruleset_version": {"minLength": 1, "type": "string"},
        "version": {"minLength": 1, "type": "string"}
      },
      "required": ["name", "version", "ruleset_version"],
      "type": "object"
    }
  },
  "required": ["schema_version", "created_on", "tool", "source", "root_causes"],
  "title": "PgExtAssure baseline 1.0",
  "type": "object"
}
